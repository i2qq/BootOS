#include <windows.h>

1 RT_MANIFEST "src/bootos-flasher.manifest"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "BootOS Project"
            VALUE "FileDescription",  "BootOS USB Creator and Disk Preparation Utility"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "bootos-flasher-gui"
            VALUE "LegalCopyright",   "Copyright (C) 2026 BootOS Project"
            VALUE "OriginalFilename", "bootos-flasher-gui.exe"
            VALUE "ProductName",      "BootOS USB Flasher"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
